{
  "name": "dsh-opencode-go-key-broker",
  "version": "0.1.1",
  "private": true,
  "description": "DSH plugin: automatic OpenCode Go API-key switching driven by subscription quota (rolling/weekly/monthly), with a Settings tab for pool management and a manual override.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/host.test.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "opencode-go",
    "credentials",
    "quota"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-home-paths": "*"
  }
}
